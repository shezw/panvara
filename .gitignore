# Agent workflow records stay local; durable internal knowledge is versioned.
/.agent/*
!/.agent/architecture/
!/.agent/architecture/**
!/.agent/development/
!/.agent/development/**
!/.agent/meta/
!/.agent/meta/**
!/.agent/operations/
!/.agent/operations/**
!/.agent/product/
!/.agent/product/**
!/.agent/reviews/
!/.agent/reviews/**
!/.agent/templates/
!/.agent/templates/**
!/.agent/tests/
/.agent/tests/*
!/.agent/tests/manual/
!/.agent/tests/manual/**

# Go
/bin/
/dist/
*.out
coverage*.txt

# Documentation toolchain
/node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/

# Local environment
.env
.env.*
!.env.example

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Local runtime data
/.data/
