# Panvara
# .env.example    2026-07-14
#
# @link    : https://github.com/shezw/panvara
# @author  : shezw
# @email   : hello@shezw.com

PANVARA_PROFILE=server
PANVARA_HTTP_ADDR=127.0.0.1:8080
PANVARA_DATABASE_URL=postgres://panvara:panvara-dev@127.0.0.1:5432/panvara?sslmode=disable
PANVARA_MODULE_SOURCE=examples/modules/crm-leads.yaml
PANVARA_MODULE_FORMAT=auto
PANVARA_PROJECT_ID=01981234-5678-7abc-8def-0123456789ab
PANVARA_PROJECT_KEY=crm
PANVARA_PROJECT_LOCALE=en-US
PANVARA_PROJECT_TIME_ZONE=UTC
PANVARA_PROJECT_CURRENCY=USD
PANVARA_ENVIRONMENT_KEY=default

# Required only when this Project is initialized for the first time. Panvara
# persists its digest as a bootstrap credential; later restarts may omit it.
# Keep this empty in tracked files and never replace it with a different value
# for an initialized Project. Use 32-1024 HTTP Bearer-safe ASCII bytes
# (letters, digits, -._~+/, with = only as trailing padding). The reserved
# `pvk1.` prefix is only for credentials issued by Panvara.
PANVARA_ADMIN_TOKEN=

PANVARA_COMPOSE_PROJECT=panvara
PANVARA_POSTGRES_PORT=5432
