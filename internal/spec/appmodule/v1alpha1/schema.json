{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panvara.dev/schemas/appmodule/v1alpha1/schema.json",
  "title": "Panvara AppModule v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "panvara.dev/v1alpha1" },
    "kind": { "const": "AppModule" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "moduleName": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "schemaName": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "versionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "anyOf": [
        { "const": "*" },
        { "pattern": "^\\^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
        { "$ref": "#/$defs/semver" },
        { "pattern": "^(?:>=|<=|>|<|=)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?: (?:>=|<=|>|<|=)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)*$" }
      ]
    },
    "stringSet": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/schemaName" }
    },
    "operations": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["list", "get", "create", "patch", "delete"] }
    },
    "publicOperations": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "const": "create" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/moduleName" },
        "version": { "$ref": "#/$defs/semver" },
        "labels": { "$ref": "#/$defs/labels" }
      }
    },
    "moduleRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/moduleName" },
        "version": { "$ref": "#/$defs/versionRange" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/moduleRequirement" }
        },
        "capabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+/v(?:0|[1-9][0-9]*)(?:(?:alpha|beta)(?:0|[1-9][0-9]*))?$"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "precision": { "type": "integer", "minimum": 1, "maximum": 38 },
        "scale": { "type": "integer", "minimum": 0, "maximum": 38 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/schemaName" },
        "labels": { "$ref": "#/$defs/labels" },
        "type": { "enum": ["string", "text", "int", "bool", "decimal", "enum", "date", "datetime", "email", "money", "reference"] },
        "required": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "target": { "$ref": "#/$defs/schemaName" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9_-]*$" }
        },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": { "$ref": "#/$defs/operations" },
        "writable": { "$ref": "#/$defs/stringSet" },
        "filterable": { "$ref": "#/$defs/stringSet" },
        "sortable": { "type": "array", "maxItems": 0 }
      }
    },
    "publicAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": { "$ref": "#/$defs/publicOperations" },
        "writable": { "$ref": "#/$defs/stringSet" },
        "filterable": { "type": "array", "maxItems": 0 },
        "sortable": { "type": "array", "maxItems": 0 }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": { "$ref": "#/$defs/publicAccess" },
        "admin": { "$ref": "#/$defs/access" }
      }
    },
    "listView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": { "$ref": "#/$defs/stringSet" },
        "filters": { "$ref": "#/$defs/stringSet" }
      }
    },
    "formView": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "fields": { "$ref": "#/$defs/stringSet" } }
    },
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": { "$ref": "#/$defs/listView" },
        "form": { "$ref": "#/$defs/formView" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/schemaName" },
        "labels": { "$ref": "#/$defs/labels" },
        "fields": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/field" }
        },
        "api": { "$ref": "#/$defs/api" },
        "manager": { "$ref": "#/$defs/manager" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": { "$ref": "#/$defs/requirements" },
        "provides": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+/v(?:0|[1-9][0-9]*)(?:(?:alpha|beta)(?:0|[1-9][0-9]*))?$"
          }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/moduleName" }
        },
        "resources": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    }
  }
}
